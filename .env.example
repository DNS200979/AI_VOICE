# VOX-ISP — variáveis de ambiente (copie para .env e preencha)

# --- Persistência ---
DATABASE_URL=postgresql+asyncpg://voxisp:voxisp@localhost:5432/voxisp
REDIS_URL=redis://localhost:6379/0
# true liga a gravação real de call/turn/action/escalation no Postgres
# (via `make up`). false (padrão) roda a API de demo 100% em memória.
PERSISTENCE_ENABLED=false

# --- Tenant padrão (dev) ---
DEFAULT_TENANT_ID=demo

# --- Conector ISP ativo: mock | hubsoft | ixc | sgp | voalle ---
ISP_CONNECTOR=mock

# --- Hubsoft (ver docs/connectors/hubsoft.md) ---
# Endpoints confirmados contra a doc oficial (docs.hubsoft.com.br /
# github.com/hubsoftbrasil/api). OAuth2 "password grant": as 4 credenciais
# abaixo são obrigatórias. HUBSOFT_BASE_URL é o domínio do provedor no
# Hubsoft (ex.: https://suaempresa.hubsoft.com.br), sem barra no final.
HUBSOFT_BASE_URL=
HUBSOFT_CLIENT_ID=
HUBSOFT_CLIENT_SECRET=
HUBSOFT_USERNAME=
HUBSOFT_PASSWORD=
# id_motivo_remocao_agendamento exigido pelo cancelamento de visita
# (OPS-02) — sem catálogo fixo documentado, ver docs/connectors/hubsoft.md.
HUBSOFT_CANCEL_REASON_ID=

# --- ACS (ver docs/connectors/genieacs.md) ---
# Fonte de get_cpe_diagnostics/reboot_cpe. "none" (padrão) = esses dois
# métodos caem no que o ERP escolhido já fizer (MockISPConnector funciona
# nativamente; HubsoftConnector levanta NotImplementedError — confirmado
# que não existe no ERP).
ACS_PROVIDER=none          # none | genieacs
GENIEACS_BASE_URL=
GENIEACS_USERNAME=
GENIEACS_PASSWORD=
# Sem padrão TR-181 universal de potência óptica entre fabricantes de ONT
# (confirmado). Abaixo deste limiar em dBm, o adapter classifica ONUStatus.LOS.
GENIEACS_RX_POWER_LOS_THRESHOLD_DBM=-28.0

# --- NMS (ver docs/connectors/zabbix.md) ---
# Fonte de get_area_incidents (correlação de massivo, spec §4.5). "none"
# (padrão) = mesmo fallback do ACS acima.
NMS_PROVIDER=none          # none | zabbix
ZABBIX_BASE_URL=
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
# Tag do host no Zabbix usada para correlacionar com o olt_id do ERP (não
# há correlação automática entre os dois espaços de ID) — ver
# docs/connectors/zabbix.md.
ZABBIX_OLT_TAG_KEY=olt_id

# --- ASR (ver docs/voice/deepgram.md) ---
ASR_PROVIDER=stub          # stub | deepgram
ASR_API_KEY=
ASR_LANGUAGE=pt-BR
ASR_SAMPLE_RATE=8000
ASR_ENCODING=linear16      # linear16 | mulaw | alaw — depende do que a ponte de telefonia entrega

# --- TTS (ver docs/voice/elevenlabs.md) ---
TTS_PROVIDER=stub          # stub | elevenlabs
TTS_API_KEY=
# Sem default genérico — é uma voz específica da conta ElevenLabs do provedor.
TTS_VOICE_ID=
TTS_OUTPUT_FORMAT=alaw_8000  # G.711 A-law 8kHz — mesmo codec de telefonia do Brasil

# --- LLM (classificação de intenção / redação de turno) ---
LLM_PROVIDER=stub          # stub | anthropic | openai | google
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Telefonia (Asterisk/Kamailio) ---
ARI_URL=http://localhost:8088/ari
ARI_USER=voxisp
ARI_PASSWORD=changeme

# --- Detecção de massivo (NET-03) ---
MASSIVE_LOS_THRESHOLD=3
MASSIVE_WINDOW_MINUTES=15

# --- Observabilidade ---
LOG_LEVEL=INFO
