# VOX-ISP — variáveis de ambiente (copie para .env e preencha)

# --- Persistência ---
DATABASE_URL=postgresql+asyncpg://voxisp:voxisp@localhost:5432/voxisp
REDIS_URL=redis://localhost:6379/0

# --- Tenant padrão (dev) ---
DEFAULT_TENANT_ID=demo

# --- Conector ISP ativo: mock | hubsoft | ixc | sgp | voalle ---
ISP_CONNECTOR=mock

# --- ASR (Speech-to-Text) ---
ASR_PROVIDER=stub          # stub | deepgram | azure | riva
ASR_API_KEY=

# --- TTS (Text-to-Speech) ---
TTS_PROVIDER=stub          # stub | elevenlabs | cartesia | azure | google
TTS_API_KEY=

# --- LLM (classificação de intenção / redação de turno) ---
LLM_PROVIDER=stub          # stub | anthropic | openai | google
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Telefonia (Asterisk/Kamailio) ---
ARI_URL=http://localhost:8088/ari
ARI_USER=voxisp
ARI_PASSWORD=changeme

# --- Detecção de massivo (NET-03) ---
MASSIVE_LOS_THRESHOLD=3
MASSIVE_WINDOW_MINUTES=15

# --- Observabilidade ---
LOG_LEVEL=INFO
